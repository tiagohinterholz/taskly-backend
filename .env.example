# Copy to .env and fill in real values. Never commit .env.

# --- Database (T2) ---
DATABASE_URL=postgresql+asyncpg://taskly:taskly@localhost:5432/taskly

# --- Auth / JWT (core/security.py) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Login rate limiting (AuthService) ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Attachment storage (storage/backend.py) ---
# One of: local, s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/attachments

# --- S3 storage backend (production only, required when STORAGE_BACKEND=s3) ---
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- CORS (frontend origin) ---
CORS_ORIGIN=http://localhost:5173
